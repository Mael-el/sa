# PostgreSQL: use a dedicated application account in production.
# Remote connections require sslmode=require (and a trusted server certificate).
DATABASE_URL=postgresql://sante_app:CHANGE_ME@127.0.0.1:5432/sante

# Generate independent random secrets; never commit .env.local.
# SESSION_SECRET: at least 48 characters.
# DATA_ENCRYPTION_KEY: exactly 32 random bytes encoded as 64 hexadecimal characters.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# One-time bootstrap of the single default administrator.
# Leave ADMIN_INITIAL_PASSWORD empty to generate a strong temporary password.
ADMIN_EMAIL=admin@santeplus.bj
ADMIN_NAME=Administrateur SANTÉ+
ADMIN_INITIAL_PASSWORD=
ADMIN_SUPPORT_EMAIL=contact@santeplus.bj

# SMTP: transactional emails (reset codes, account invitations, security alerts).
# Leave SMTP_HOST empty to keep manual delivery by an administrator: nothing breaks,
# but no email is sent. Port 465 implies TLS; port 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SANTÉ+ Bénin <ne-pas-repondre@exemple.bj>"

# Optional external assistant; leave unset to keep the assistant local.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional override for the smoke-test target.
TEST_BASE_URL=http://127.0.0.1:3000
